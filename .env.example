# 이 파일을 복사해서 .env를 만들고 값을 채워 주세요. (.env는 커밋되지 않아요)

# 서버 포트 (기본값 5050)
PORT=

# 몽고디비 주소 (기본값 mongodb://127.0.0.1:27017/todo)
MONGODB_URI=

# Firebase 서비스 계정 키: 아래 둘 중 하나만 설정하면 돼요. (둘 다 있으면 FIREBASE_SERVICE_ACCOUNT를 써요)
# 키는 Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"으로 받아요.

# 1) 로컬 개발용: 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=

# 2) 배포 서버용: 키 JSON 내용 (한 줄 JSON 또는 base64)
#    한 줄 JSON 복사: node -e 'console.log(JSON.stringify(require("./키파일.json")))' | pbcopy
FIREBASE_SERVICE_ACCOUNT=

# 요청을 허용할 프론트엔드 주소 (쉼표로 구분, 비우면 Live Server 5500 포트와 Firebase Hosting 주소)
CORS_ORIGINS=
